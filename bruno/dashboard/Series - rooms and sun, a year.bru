meta {
  name: Series - rooms and sun, a year
  type: http
  seq: 10
}

get {
  url: {{dashboard_url}}/api/v1/stations/{{station}}/series?metrics=rooms.temperature,rooms.humidity,solar.radiation,solar.uv_index&range=1y&lang={{lang}}
  body: none
  auth: none
}

params:query {
  metrics: rooms.temperature,rooms.humidity,solar.radiation,solar.uv_index
  range: 1y
  lang: {{lang}}
}

assert {
  res.status: eq 200
  res.body.series: isArray
}
