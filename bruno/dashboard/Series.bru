meta {
  name: Series
  type: http
  seq: 7
}

get {
  url: {{dashboard_url}}/api/v1/stations/{{station}}/series?metrics=outdoor.temperature,outdoor.dew_point&range=24h&model=false&lang={{lang}}
  body: none
  auth: none
}

params:query {
  metrics: outdoor.temperature,outdoor.dew_point
  range: 24h
  model: false
  ~temperature: f
  ~pressure: inhg
  ~rain: in
  ~wind: mph
  ~distance: mi
  lang: {{lang}}
}

assert {
  res.status: eq 200
  res.body.series: isArray
}

docs {
  metrics: one or more ids from Meta, comma-separated. range: 1h 3h 6h 12h 24h 7d 30d 1y. model=true adds the weather model's series where it has the metric.
}
