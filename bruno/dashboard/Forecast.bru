meta {
  name: Forecast
  type: http
  seq: 11
}

get {
  url: {{dashboard_url}}/api/v1/stations/{{station}}/forecast?lang={{lang}}
  body: none
  auth: none
}

params:query {
  ~temperature: f
  ~pressure: inhg
  ~rain: in
  ~wind: mph
  ~distance: mi
  lang: {{lang}}
}

assert {
  res.status: eq 200
  res.body.hours: isArray
  res.body.days: isArray
}

docs {
  No hours or days for a station that does not store its weather model's forecast.
}
