meta {
  name: Stations
  type: http
  seq: 2
}

get {
  url: {{dashboard_url}}/api/v1/stations?lang={{lang}}
  body: none
  auth: none
}

params:query {
  lang: {{lang}}
}

vars:post-response {
  station: res.body[0].id
}

assert {
  res.status: eq 200
  res.body: isArray
  res.body[0].id: isString
}
