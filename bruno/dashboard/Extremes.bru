meta {
  name: Extremes
  type: http
  seq: 12
}

get {
  url: {{dashboard_url}}/api/v1/stations/{{station}}/extremes?period=today&lang={{lang}}
  body: none
  auth: none
}

params:query {
  period: today
  ~temperature: f
  ~pressure: inhg
  ~rain: in
  ~wind: mph
  ~distance: mi
  lang: {{lang}}
}

assert {
  res.status: eq 200
  res.body.period: eq today
}

docs {
  period: today, month or year.
}
