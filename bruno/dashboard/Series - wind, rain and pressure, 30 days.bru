meta {
  name: Series - wind, rain and pressure, 30 days
  type: http
  seq: 9
}

get {
  url: {{dashboard_url}}/api/v1/stations/{{station}}/series?metrics=wind.speed,wind.gust,wind.direction,rain.daily,pressure.sea_level&range=30d&lang={{lang}}
  body: none
  auth: none
}

params:query {
  metrics: wind.speed,wind.gust,wind.direction,rain.daily,pressure.sea_level
  range: 30d
  lang: {{lang}}
}

assert {
  res.status: eq 200
  res.body.series: isArray
}
