meta {
  name: Now
  type: http
  seq: 3
}

get {
  url: {{dashboard_url}}/api/v1/stations/{{station}}/now?lang={{lang}}
  body: none
  auth: none
}

params:query {
  ~temperature: f
  ~pressure: inhg
  ~rain: in
  ~wind: mph
  ~distance: mi
  lang: {{lang}}
}

assert {
  res.status: eq 200
  res.body.summary: isString
  res.body.timezone: isString
}
