# Only each Python project's pyproject.toml and src/, and the sources the dashboard's pages are
# built from, are copied into the images. Everything else stays
# out of the build context, which matters most for data/: config.yaml holds PASSKEYs,
# dashboard.yaml a database token, and secret.key signs the admin forms, and the context is
# sent to the Docker daemon in full.
*
!core/pyproject.toml
!core/src/
!collector/pyproject.toml
!collector/src/
!dashboard/api/pyproject.toml
!dashboard/api/src/
!dashboard/web/package.json
!dashboard/web/package-lock.json
!dashboard/web/.npmrc
!dashboard/web/index.html
!dashboard/web/vite.config.ts
!dashboard/web/svelte.config.js
!dashboard/web/tsconfig.json
!dashboard/web/src/
!dashboard/web/public/
**/node_modules
**/*.test.ts
**/__pycache__
