{
  "name": "ecowitt-dashboard-web",
  "private": true,
  "version": "3.6.1",
  "description": "Ecowitt Server's public dashboard pages: a thin client of the dashboard API",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node build/compile-messages.ts && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/plugin-message-format": "4.6.0",
    "@jmerhar/frontend-config": "^0.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/svelte": "5.4.2",
    "@vitejs/plugin-legacy": "8.2.4",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "31.0.1",
    "lightningcss": "1.33.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "terser": "5.51.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@bybas/weather-icons": "2.0.0",
    "@jmerhar/jigkit": "0.21.0",
    "@lucide/svelte": "1.73.0",
    "uplot": "1.6.32"
  },
  "allowScripts": {
    "core-js": false,
    "fsevents": false
  }
}
