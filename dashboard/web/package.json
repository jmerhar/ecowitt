{
  "name": "ecowitt-dashboard-web",
  "private": true,
  "version": "2.8.1",
  "description": "Ecowitt Server's public dashboard pages: a thin client of the dashboard API",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node build/compile-messages.ts && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.25.4",
    "@inlang/plugin-message-format": "4.4.4",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@vitejs/plugin-legacy": "8.2.3",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "30.1.1",
    "lightningcss": "1.33.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "terser": "5.51.2",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@bybas/weather-icons": "2.0.0",
    "@lucide/svelte": "1.49.0",
    "uplot": "1.6.32"
  }
}
